import java.util.Scanner;

public class ShortestPath {
    static int minDistance = Integer.MAX_VALUE;
    static String bestPath = "";

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        // Input number of locations
        System.out.print("Enter the number of locations: ");
        int n = scanner.nextInt();
        
        int[][] distance = new int[n][n];
        
        // Input the distance between each pair of locations
        System.out.println("Enter the distance matrix (enter 0 for same locations):");
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                distance[i][j] = scanner.nextInt();
            }
        }
        
        // Start the recursive search from location 0
        boolean[] visited = new boolean[n];
        visited[0] = true;
        findShortestPath(distance, visited, 0, n, 1, 0, "0");

        System.out.println("Shortest Path: " + bestPath);
        System.out.println("Minimum Distance: " + minDistance);
        
        scanner.close();
    }

    // Recursive function to find the shortest path
    private static void findShortestPath(int[][] distance, boolean[] visited, int currentLocation, int n, int count, int currentDistance, String path) {
        // If all locations are visited, check if current path is shorter than the best found
        if (count == n && distance[currentLocation][0] > 0) {
            int totalDistance = currentDistance + distance[currentLocation][0];
            if (totalDistance < minDistance) {
                minDistance = totalDistance;
                bestPath = path + " -> 0";  // Complete the cycle
            }
            return;
        }
        
        // Try all possible next locations
        for (int i = 0; i < n; i++) {
            if (!visited[i] && distance[currentLocation][i] > 0) {
                visited[i] = true;
                findShortestPath(distance, visited, i, n, count + 1, currentDistance + distance[currentLocation][i], path + " -> " + i);
                visited[i] = false;
            }
        }
    }
}
